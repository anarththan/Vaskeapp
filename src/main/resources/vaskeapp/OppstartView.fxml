<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
      <?import javafx.scene.control.ComboBox?>
      <?import javafx.scene.control.Label?>
      <?import javafx.scene.control.TextField?>
      <?import javafx.scene.layout.AnchorPane?>
      
      <AnchorPane fx:id="background"
                  prefHeight="400.0"
                  prefWidth="600.0"
                  xmlns="http://javafx.com/javafx"
                  xmlns:fx="http://javafx.com/fxml"
                  fx:controller="vaskeapp.OppstartController">
      
          <children>
              <Label layoutX="25.0" layoutY="30.0" text="Oppstart (4 Personer / 4 Områder)" />
      
              <!-- Person 1 -->
              <Label layoutX="25.0" layoutY="80.0" text="Person 1:" />
              <TextField fx:id="navnField1" layoutX="100.0" layoutY="75.0" prefWidth="120.0" />
              <ComboBox fx:id="areaBox1" layoutX="230.0" layoutY="75.0" prefWidth="150.0" />
      
              <!-- Person 2 -->
              <Label layoutX="25.0" layoutY="120.0" text="Person 2:" />
              <TextField fx:id="navnField2" layoutX="100.0" layoutY="115.0" prefWidth="120.0" />
              <ComboBox fx:id="areaBox2" layoutX="230.0" layoutY="115.0" prefWidth="150.0" />
      
              <!-- Person 3 -->
              <Label layoutX="25.0" layoutY="160.0" text="Person 3:" />
              <TextField fx:id="navnField3" layoutX="100.0" layoutY="155.0" prefWidth="120.0" />
              <ComboBox fx:id="areaBox3" layoutX="230.0" layoutY="155.0" prefWidth="150.0" />
      
              <!-- Person 4 -->
              <Label layoutX="25.0" layoutY="200.0" text="Person 4:" />
              <TextField fx:id="navnField4" layoutX="100.0" layoutY="195.0" prefWidth="120.0" />
              <ComboBox fx:id="areaBox4" layoutX="230.0" layoutY="195.0" prefWidth="150.0" />
      
              <!-- Neste Knapp -->
              <Button fx:id="nesteButton"
                      layoutX="410.0"
                      layoutY="240.0"
                      text="Neste"
                      onAction="#handleNeste" />
          </children>
      </AnchorPane>
      